generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id        String @id @default(uuid())
  name      String
  email     String
  image_url String

  @@map("customers")
}

model Invoice {
  id          String   @id @default(uuid())
  customer_id String
  amount      Int
  status      String
  date        DateTime

  @@map("invoices")
}

model Revenue {
  month   String @id @unique
  revenue Int

  @@map("revenue")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  role      Role     @default(USER)
  updatedAt DateTime @updatedAt
  username  String?

  @@map("users")
}

enum Role {
  USER
  EMPLOYEE
  ADMIN
  MANAGER
}
